+// Android 15+ Codec2 needs a process-side Binder pool even without a Java VM.
+// Keep the library loaded because its threads live until decoder-process exit.
+static PRStatus StartTermuxBinderPool() {
+  void* library = dlopen("libbinder_ndk.so", RTLD_NOW | RTLD_LOCAL);
+  if (!library) {
+    return PR_FAILURE;
+  }
+  auto setMax = reinterpret_cast<bool (*)(uint32_t)>(
+      dlsym(library, "ABinderProcess_setThreadPoolMaxThreadCount"));
+  auto start = reinterpret_cast<void (*)()>(
+      dlsym(library, "ABinderProcess_startThreadPool"));
+  if (!start) {
+    dlclose(library);
+    return PR_FAILURE;
+  }
+  if (setMax) {
+    setMax(1);
+  }
+  start();
+  return PR_SUCCESS;
+}
