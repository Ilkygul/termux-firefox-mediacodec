+MediaResult FFmpegVideoDecoder<LIBAV_VER>::InitTermuxMediaCodecDecoder() {
+  if (!mTermuxMediaCodecAllowed ||
+      !StaticPrefs::media_hardware_video_decoding_enabled_AtStartup() ||
+      mLowLatency || mInfo.HasAlpha() ||
+      mInfo.mColorDepth != gfx::ColorDepth::COLOR_8) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("MediaCodec not eligible for this stream"));
+  }
+  const char* name = nullptr;
+  switch (mCodecID) {
+    case AV_CODEC_ID_H264: {
+      if (!mExtraData || mExtraData->Length() < 2 ||
+          mExtraData->Elements()[0] != 1) {
+        return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                           RESULT_DETAIL("MediaCodec needs AVC configuration"));
+      }
+      const uint8_t profile = mExtraData->Elements()[1];
+      if (profile != 66 && profile != 77 && profile != 88 && profile != 100) {
+        return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                           RESULT_DETAIL("MediaCodec AVC profile not validated"));
+      }
+      name = "h264_mediacodec";
+      break;
+    }
+    case AV_CODEC_ID_VP9:
+      name = "vp9_mediacodec";
+      break;
+    default:
+      return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                         RESULT_DETAIL("MediaCodec codec not validated"));
+  }
+  AVCodec* codec = mLib->avcodec_find_decoder_by_name(name);
+  if (!codec) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("MediaCodec decoder not in system FFmpeg"));
+  }
+  static PRCallOnceType binderOnce;
+  if (PR_CallOnce(&binderOnce, StartTermuxBinderPool) != PR_SUCCESS) {
+    return MediaResult(NS_ERROR_DOM_MEDIA_FATAL_ERR,
+                       RESULT_DETAIL("MediaCodec Binder callbacks unavailable"));
+  }
+  AVDictionary* options = nullptr;
+  if (mLib->av_dict_set(&options, "ndk_codec", "1", 0) < 0) {
+    mLib->av_dict_free(&options);
+    return MediaResult(NS_ERROR_OUT_OF_MEMORY, __func__);
+  }
+  mUsingTermuxMediaCodec = true;
+  MediaResult result = InitDecoder(codec, &options);
+  mLib->av_dict_free(&options);
+  if (NS_FAILED(result)) {
+    mUsingTermuxMediaCodec = false;
+  }
+  return result;
+}
